<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="glc2dcsharp" Version="0.1.0.8" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.WinForms" Version="3.8.3" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.3" />
    <PackageReference Include="Vortice.XInput" Version="3.8.3" />
  </ItemGroup>

  <!-- 실행 위치와 관계없이 이미지를 찾을 수 있도록 출력 폴더에 복사합니다. -->
  <ItemGroup>
    <Content Include="..\..\..\resource\background\PunchStep_*.png">
      <Link>resource\background\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\resource\animation\animation_player\Player_Stand_Right.png">
      <Link>resource\animation\animation_player\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\resource\animation\animation_player\Player_Punch_Right.png">
      <Link>resource\animation\animation_player\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 몬스터 기본 이미지·터지는 시트와 포탈 시트를 실행 폴더에 복사합니다. -->
  <ItemGroup>
    <Content Include="..\..\..\resource\animation\animation_monster\*.png">
      <Link>resource\animation\animation_monster\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 타이틀 배경과 투명 버튼 이미지도 실행/배포 폴더로 복사합니다. -->
  <ItemGroup>
    <Content Include="..\..\..\resource\title\PunchStep_Title_*.png">
      <Link>resource\title\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 플레이 장면에서 사용하는 BGM도 실행 파일과 함께 복사합니다. -->
  <ItemGroup>
    <Content Include="..\..\..\resource\sound\bgm\PunchStep_Gameplay.mp3">
      <Link>resource\sound\bgm\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
